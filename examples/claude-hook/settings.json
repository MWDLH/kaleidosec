{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"/ABSOLUTE/PATH/TO/kaleidosec/hooks/kaleido_gate.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"/ABSOLUTE/PATH/TO/kaleidosec/hooks/kaleido_gate.py\" user-prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
